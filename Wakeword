package com.alex.assistant

import android.app.Notification
import android.app.NotificationChannel
import android.app.NotificationManager
import android.content.Context
import android.media.AudioFormat
import android.media.AudioManager
import android.media.AudioRecord
import android.media.MediaRecorder
import android.media.audiofx.AcousticEchoCanceler
import android.media.audiofx.AutomaticGainControl
import android.media.audiofx.NoiseSuppressor
import android.os.PowerManager
import org.json.JSONObject
import org.vosk.LibVosk
import org.vosk.LogLevel
import org.vosk.Model
import org.vosk.Recognizer
import java.io.BufferedInputStream
import java.io.File
import java.io.FileInputStream
import java.io.FileOutputStream
import java.net.HttpURLConnection
import java.net.URL
import java.util.zip.ZipInputStream
import kotlin.concurrent.thread
import kotlin.math.max

object WakeWord {
    private const val URL_MODEL = "https://alphacephei.com/vosk/models/vosk-model-small-en-us-0.15.zip"
    private const val DIR = "vosk/vosk-model-small-en-us-0.15"

    // Strict 2-word wake phrases ONLY ("Hey Meera", "Oi Meera" [ওই মীরা], "Ei Meera" [এই মীরা])
    // Plus phonetic sink/decoy words so random background conversation from friends is absorbed by sinks/[unk] and NEVER false-triggers!
    private const val GRAMMAR =
        "[\"hey meera\", \"hey mira\", \"hey mirror\", " +
            "\"oi meera\", \"oi mira\", \"oi mirror\", \"oy meera\", \"oy mira\", \"oy mirror\", \"oh meera\", \"oh mira\", \"oh mirror\", " +
            "\"ei meera\", \"ei mira\", \"ei mirror\", \"a meera\", \"a mira\", \"a mirror\", " +
            "\"stop\", \"torch on\", \"torch off\", " +
            "\"the\", \"to\", \"in\", \"is\", \"it\", \"on\", \"at\", \"no\", \"go\", \"so\", \"do\", \"you\", \"we\", \"he\", \"me\", \"my\", \"by\", \"or\", \"for\", \"are\", \"but\", \"not\", \"what\", \"that\", \"this\", \"with\", \"have\", \"from\", \"they\", \"talk\", \"yes\", \"ok\", \"hello\", \"hi\", \"meera\", \"mira\", \"mirror\", \"mia\", \"[unk]\"]"

    // MANDATORY 2-WORD WAKE REGEX:
    // Must have prefix ("hey" / "oi" / "oy" / "oh" / "ei" / "a") followed by ("meera" / "mira" / "mirror").
    // Standalone "meera" or random words will NEVER match!
    private val STRICT_WAKE_HIT = Regex(
        "(?i)\\b(hey|oi|oy|oh|ei|a)\\s+(meera|mira|mirror)\\b"
    )
    private val CMD_STOP = Regex("(?i)^\\s*stop\\s*$")
    private val CMD_TORCH_ON = Regex("(?i)\\b(torch on)\\b")
    private val CMD_TORCH_OFF = Regex("(?i)\\b(torch off)\\b")

    @Volatile var listening: Boolean = false
    @Volatile var state: String = ""
    @Volatile private var running: Boolean = false
    @Volatile private var downloading: Boolean = false
    private var worker: Thread? = null

    fun modelDir(ctx: Context): File = File(ctx.filesDir, DIR)

    fun modelReady(ctx: Context): Boolean {
        val d = modelDir(ctx)
        return File(d, "conf").isDirectory && File(d, "am").isDirectory
    }

    fun hideMicIndicatorsAndAodIcon(ctx: Context) {
        try {
            val nm = ctx.getSystemService(NotificationManager::class.java)
            if (nm != null) {
                val ch = NotificationChannel("alex", "Meera", NotificationManager.IMPORTANCE_MIN).apply {
                    lockscreenVisibility = Notification.VISIBILITY_SECRET
                    setShowBadge(false)
                }
                nm.createNotificationChannel(ch)
                val silentNotif = Notification.Builder(ctx, "alex")
                    .setContentTitle("Meera")
                    .setSmallIcon(android.R.color.transparent)
                    .setVisibility(Notification.VISIBILITY_SECRET)
                    .setOngoing(true)
                    .build()
                nm.notify(1, silentNotif)
            }
        } catch (_: Exception) {}

        try {
            if (ShizukuHelper.granted() && !ShizukuHelper.ready()) {
                ShizukuHelper.bind()
            }
            if (ShizukuHelper.ready()) {
                ShizukuHelper.exec(
                    "cmd device_config set_sync_disabled_for_tests persistent; " +
                        "cmd device_config put privacy camera_mic_icons_enabled false default; " +
                        "device_config put privacy camera_mic_icons_enabled false default; " +
                        "cmd device_config put privacy location_indicators_enabled false default; " +
                        "settings put secure camera_mic_icons_enabled 0; " +
                        "cmd notification set_bubbles ${ctx.packageName} 0"
                )
            }
        } catch (_: Exception) {}
    }

    fun download(ctx: Context) {
        if (downloading || modelReady(ctx)) return
        downloading = true
        state = "download shuru..."
        val app = ctx.applicationContext
        thread(start = true, name = "meera-model") {
            val zip = File(app.filesDir, "vosk.zip")
            try {
                val conn = (URL(URL_MODEL).openConnection() as HttpURLConnection).apply {
                    instanceFollowRedirects = true
                    connectTimeout = 20_000
                    readTimeout = 30_000
                }
                val total = conn.contentLengthLong
                conn.inputStream.use { ins ->
                    FileOutputStream(zip).use { out ->
                        val buf = ByteArray(65536)
                        var done = 0L
                        while (true) {
                            val n = ins.read(buf)
                            if (n <= 0) break
                            out.write(buf, 0, n)
                            done += n
                            state = if (total > 0) {
                                "downloading ${done * 100 / total}%"
                            } else {
                                "downloading ${done / 1_000_000} MB"
                            }
                        }
                    }
                }
                state = "unzip..."
                val root = File(app.filesDir, "vosk").apply { mkdirs() }
                ZipInputStream(BufferedInputStream(FileInputStream(zip), 8192)).use { zin ->
                    while (true) {
                        val e = zin.nextEntry ?: break
                        val f = File(root, e.name)
                        if (!f.canonicalPath.startsWith(root.canonicalPath + File.separator)) {
                            throw SecurityException("bad zip entry")
                        }
                        if (e.isDirectory) {
                            f.mkdirs()
                        } else {
                            f.parentFile?.mkdirs()
                            FileOutputStream(f).use { zin.copyTo(it) }
                        }
                    }
                }
                zip.delete()
                state = if (modelReady(app)) "ready" else "error: model folder pawa gelo na"
            } catch (e: Exception) {
                state = "error: ${e.message}"
                AlexLog.add("model download error: ${e.message}")
            } finally {
                downloading = false
                AlexService.instance?.refreshWake()
            }
        }
    }

    fun start(ctx: Context, onWake: () -> Unit) {
        if (running || !modelReady(ctx)) return
        running = true
        val app = ctx.applicationContext
        worker = thread(start = true, name = "meera-wake") {
            var model: Model? = null
            var recog: Recognizer? = null
            var ar: AudioRecord? = null
            var aec: AcousticEchoCanceler? = null
            var ns: NoiseSuppressor? = null
            var agc: AutomaticGainControl? = null
            var fired = false
            try {
                hideMicIndicatorsAndAodIcon(app)
                LibVosk.setLogLevel(LogLevel.WARNINGS)
                val m = Model(modelDir(app).absolutePath)
                model = m
                val r = Recognizer(m, 16000f, GRAMMAR)
                recog = r
                val am = app.getSystemService(AudioManager::class.java)
                val pm = app.getSystemService(PowerManager::class.java)
                val rawBuf = ByteArray(3200)
                val cleanBuf = ByteArray(3200)
                var lastHit = 0L
                var activeSpeechCountdown = 0

                while (running) {
                    if (am.mode == AudioManager.MODE_IN_CALL) {
                        if (ar != null) {
                            try { aec?.release() } catch (_: Exception) {}
                            try { ns?.release() } catch (_: Exception) {}
                            try { agc?.release() } catch (_: Exception) {}
                            aec = null
                            ns = null
                            agc = null
                            try { ar?.stop() } catch (_: Exception) {}
                            try { ar?.release() } catch (_: Exception) {}
                            ar = null
                            listening = false
                        }
                        Thread.sleep(1000L)
                        continue
                    }

                    if (ar == null) {
                        hideMicIndicatorsAndAodIcon(app)
                        val min = AudioRecord.getMinBufferSize(
                            16000,
                            AudioFormat.CHANNEL_IN_MONO,
                            AudioFormat.ENCODING_PCM_16BIT
                        )
                        val a = try {
                            AudioRecord(
                                MediaRecorder.AudioSource.VOICE_RECOGNITION,
                                16000,
                                AudioFormat.CHANNEL_IN_MONO,
                                AudioFormat.ENCODING_PCM_16BIT,
                                max(min, 8000)
                            )
                        } catch (_: Exception) {
                            null
                        }
                        if (a == null || a.state != AudioRecord.STATE_INITIALIZED) {
                            try { a?.release() } catch (_: Exception) {}
                            AlexLog.add("wake: mic khola gelo na")
                            listening = false
                            Thread.sleep(2500L)
                            continue
                        }
                        try {
                            if (AcousticEchoCanceler.isAvailable()) {
                                aec = AcousticEchoCanceler.create(a.audioSessionId)?.apply { enabled = true }
                            }
                            if (NoiseSuppressor.isAvailable()) {
                                ns = NoiseSuppressor.create(a.audioSessionId)?.apply { enabled = true }
                            }
                            if (AutomaticGainControl.isAvailable()) {
                                agc = AutomaticGainControl.create(a.audioSessionId)?.apply { enabled = true }
                            }
                        } catch (_: Exception) {}
                        a.startRecording()
                        ar = a
                        listening = true
                        AlexLog.add("wake: Strict 'Hey/Oi/Ei Meera' + VoiceMatch listening ✔")
                    }

                    val cur = ar ?: continue
                    val n = cur.read(rawBuf, 0, rawBuf.size)
                    if (n <= 0) {
                        Thread.sleep(40L)
                        continue
                    }

                    // Filter and boost far-field distant voice using Studio VoiceFilter v2
                    val enhancedRms = VoiceFilter.enhanceFarFieldAudio(rawBuf, n, cleanBuf, false)

                    if (enhancedRms >= 85.0) {
                        activeSpeechCountdown = 8
                        // Continuously verify each frame against Oni's locked Voice Match fingerprint!
                        VoiceGuard.allowWakeAudio(app, cleanBuf, n)
                    } else if (activeSpeechCountdown > 0) {
                        activeSpeechCountdown--
                    } else {
                        continue
                    }

                    val isFinal = r.acceptWaveForm(cleanBuf, n)
                    val text = if (isFinal) {
                        JSONObject(r.result).optString("text", "")
                    } else {
                        JSONObject(r.partialResult).optString("partial", "")
                    }

                    val now = System.currentTimeMillis()
                    if (text.isBlank()) continue

                    if (isFinal && CMD_STOP.containsMatchIn(text) && VoiceGuard.verifyWakeOwner(app)) {
                        AlexLog.add("wake: Offline STOP command")
                        AlexService.instance?.sleeping = true
                        r.reset()
                        continue
                    }
                    if (isFinal && CMD_TORCH_ON.containsMatchIn(text) && VoiceGuard.verifyWakeOwner(app)) {
                        AlexLog.add("wake: Offline Torch ON")
                        Controls.torch(app, true)
                        r.reset()
                        continue
                    }
                    if (isFinal && CMD_TORCH_OFF.containsMatchIn(text) && VoiceGuard.verifyWakeOwner(app)) {
                        AlexLog.add("wake: Offline Torch OFF")
                        Controls.torch(app, false)
                        r.reset()
                        continue
                    }

                    // STRICT 2-GATE WAKE CHECK:
                    // Gate 1: Must explicitly contain "Hey Meera", "Oi Meera" (ওই মীরা), or "Ei Meera" (এই মীরা)
                    // Gate 2: Must pass Google-Assistant-style biometric Voice Match (VoiceGuard.verifyWakeOwner(app))!
                    if (STRICT_WAKE_HIT.containsMatchIn(text) && now - lastHit > 2500L) {
                        if (!VoiceGuard.verifyWakeOwner(app)) {
                            AlexLog.add("wake blocked: Friend/other voice rejected by Voice Match ('$text')")
                            r.reset()
                            continue
                        }
                        try {
                            pm?.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "alex:wake_trigger")?.acquire(10_000L)
                        } catch (_: Exception) {}
                        VoiceGuard.onWakeTriggered(app, cleanBuf, n)
                        lastHit = now
                        fired = true
                        AlexLog.add("wake: Verified Oni's Voice + '$text' ✔")
                        break
                    }
                }
            } catch (e: Throwable) {
                AlexLog.add("wake error: ${e.message}")
            } finally {
                listening = false
                try { aec?.release() } catch (_: Exception) {}
                try { ns?.release() } catch (_: Exception) {}
                try { agc?.release() } catch (_: Exception) {}
                try { ar?.stop() } catch (_: Exception) {}
                try { ar?.release() } catch (_: Exception) {}
                try { recog?.close() } catch (_: Exception) {}
                try { model?.close() } catch (_: Exception) {}
                running = false
                if (fired) {
                    onWake()
                }
            }
        }
    }

    fun stop() {
        running = false
        val w = worker
        if (w != null && w != Thread.currentThread()) {
            try { w.join(1500L) } catch (_: Exception) {}
        }
        worker = null
    }
}
